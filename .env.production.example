# Copy to .env on your self-hosted machine and set permissions to 600.
APP_DOMAIN=rank.example.com
APP_ORIGIN=https://rank.example.com
TLS_EMAIL=admin@example.com

POSTGRES_PASSWORD=replace-with-a-long-random-secret
AUTH_SECRET=replace-with-at-least-32-random-characters

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=管理员
INITIAL_ADMIN_POINTS=0
METERING_MODE=disabled
# Only amazon.com has completed the release acceptance gate.
ENABLED_MARKETPLACES=amazon.com

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailer@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=mailer@example.com
